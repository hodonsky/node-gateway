    "service",
    "soa",
    "amqp",
    "avro",
    "avsc",
    "node",
    "nodejs",
    "web",
    "node-gateway",
    "server",
    "node-server",
    "message",
    "queue"
  ],
  "author": "eric.hodonsky@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hodonsky/node-gateway/issues"
  },
  "homepage": "https://github.com/hodonsky/node-gateway#readme",
  "engines": {
    "node": ">=12.13.1",
    "npm": ">=6.14.5"
  },
  "dependencies": {
    "amqplib": "^0.5.6",
    "avsc": "^5.4.21",
    "aws-sdk": "^2.713.0",
    "cluster": "^0.7.7",
    "koa": "^2.13.0",
    "koa-bodyparser": "^4.3.0",
    "koa-combine-routers": "^4.0.2",
    "koa-cors": "0.0.16",
    "koa-helmet": "^5.2.0",
    "koa-morgan": "^1.0.1",
    "koa-router": "^9.1.0",
    "koa-sslify": "^4.0.3",
    "morgan": "^1.10.0",
    "os": "^0.1.1",
    "uuid": "^8.2.0",
    "winston": "^3.2.1",
    "winston-loggly-bulk": "^3.0.1"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^4.0.0",
    "babel-plugin-tcomb": "0.4.0",
    "@babel/cli": "^7.10.4",
    "@babel/core": "^7.10.4",
    "@babel/plugin-proposal-class-properties": "^7.10.4",
    "@babel/plugin-proposal-private-methods": "^7.10.4",
    "@babel/plugin-proposal-do-expressions": "^7.10.4",
    "@babel/plugin-proposal-export-default": "^7.0.0-beta.32",
    "@babel/plugin-proposal-export-default-from": "^7.10.4",
    "@babel/plugin-proposal-export-namespace": "^7.0.0-beta.32",
