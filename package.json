{
  "name": "@donsky/node-gateway",
  "version": "0.1.3",
  "description": "Node web server (koajs), extending routes to a message queue (amqp by default) of 'topic' and 'action'.",
  "main": "./dist/Server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "mocha --exit --require ./node_modules/babel-core/register",
    "build": "npx babel --config-file ./babel.json --ignore 'node_modules/**' --ignore './*.test.js' --ignore 'tests/**' --out-dir ./dist ./lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodonsky/node-gateway.git"
  },
  "keywords": [
